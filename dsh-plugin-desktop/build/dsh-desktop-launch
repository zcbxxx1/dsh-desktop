#!/bin/sh
# Launch the packaged DSH Desktop against its bundled runtime libraries.
#
# The package carries its own dynamic loader and library set under `lib/`
# (Ubuntu 22.04 glibc 2.35 + GTK 3.24.33 + GLib 2.72, with the GPU stack left to
# the host). The main executable has been rewritten to load that loader
# (`PT_INTERP`) and to find those libraries through `DT_RPATH` of
# `$ORIGIN:$ORIGIN/lib`.
#
# `LD_LIBRARY_PATH` is deliberately NOT used. RPATH is searched transitively for
# the whole dependency chain, so the bundled libraries resolve each other with no
# environment involvement — and, critically, host tools the application shells
# out to keep using the host's libraries. Exporting `LD_LIBRARY_PATH` instead
# made `zenity` (the directory picker) load the bundled glibc/GTK and die with
# SIGSEGV, which surfaced as "directory picker failed" in the UI.

set -eu

SELF=$0
case "$SELF" in
  */*) ;;
  *) SELF=$(command -v -- "$SELF" || printf '%s' "$SELF") ;;
esac
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)

if [ ! -x "$DIR/dsh-desktop" ]; then
  echo "dsh-desktop-launch: missing $DIR/dsh-desktop" >&2
  exit 1
fi

# A parent shell may carry Electron/Node shims (some IDEs and launchers inject
# them). ELECTRON_RUN_AS_NODE collapses Electron into plain Node, where every
# Chromium switch becomes "bad option", and NODE_OPTIONS injects a require hook.
unset ELECTRON_RUN_AS_NODE
unset NODE_OPTIONS

# Some vendors patch their own glibc with symbols that their Mesa/GLX and Vulkan
# drivers link against — Kylin V10 SP1 exports mesa_memcpy, mesa_memmove and
# mesa_memset. The bundled stock glibc does not provide them, so the host's GL
# libraries fail to resolve, Chromium's GPU process dies on every attempt, and
# the browser eventually gives up with "GPU process isn't usable. Goodbye." —
# which takes the whole application down. The shim built at package time
# re-exports them under the expected version tag; the names are vendor-specific,
# so preloading is inert on hosts that do not need it.
#
# LD_PRELOAD splits on whitespace as well as colons, so the install path's space
# ("/opt/DSH Desktop") cannot be used directly — it truncates to "/opt/DSH" and
# the loader silently ignores the entry. Stage a space-free symlink instead.
if [ -r "$DIR/libmesa_compat.so" ]; then
  shim_root="${XDG_RUNTIME_DIR:-/tmp}/dsh-desktop-shim"
  if mkdir -p "$shim_root" 2>/dev/null \
    && ln -sf "$DIR/libmesa_compat.so" "$shim_root/libmesa_compat.so" 2>/dev/null \
    && [ -r "$shim_root/libmesa_compat.so" ]; then
    LD_PRELOAD="$shim_root/libmesa_compat.so${LD_PRELOAD:+:$LD_PRELOAD}"
    export LD_PRELOAD
  else
    echo "dsh-desktop-launch: vendor glibc shim could not be staged; host GL drivers may fail" >&2
  fi
fi

# Force the vendor X11 path. /opt/x11-wayland/x11-ext.sh does exactly this for
# Kirin parts, and it is load-bearing: with XDG_SESSION_TYPE=wayland inherited
# from the desktop session the app dies with SIGSEGV before any window appears,
# while X11 mode starts cleanly. WAYLAND_DISPLAY is dropped for the same reason.
export XDG_SESSION_TYPE=x11
unset WAYLAND_DISPLAY

# The GPU stack is deliberately NOT bundled: vendor GPU drivers are
# machine-specific, so the system's own Mesa/driver set must stay authoritative.
# Only pin the Vulkan ICD when the vendor one is present, to avoid the generic
# Mesa package's unrelated AMD ICD crashing the GPU process.
if [ -r /etc/vulkan/icd.d/maleoon_vulkan.json ]; then
  VK_ICD_FILENAMES=/etc/vulkan/icd.d/maleoon_vulkan.json
  export VK_ICD_FILENAMES
fi

# Chromium's sandbox needs either a setuid `chrome-sandbox` helper or working
# unprivileged user namespaces. This package ships the helper without the setuid
# bit — Electron Builder's postinst only sets it when `unshare --user` fails, and
# on this kernel that probe succeeds while the real namespace sandbox still
# aborts the renderer. Disable it unless the caller already decided.
case " $* " in
  *" --no-sandbox "*) ;;
  *) set -- --no-sandbox "$@" ;;
esac

# Disable the GPU process unless the caller asks for it.
#
# On hosts whose Mesa cannot load a driver for the installed GPU — Kylin V10 SP1
# has no `hisi-dpu_dri.so` in any DRI search path — the GPU process dies on every
# launch. Chromium restarts it a few times and then aborts the browser process,
# and in the meantime the renderer never paints: the application logs
# "renderer surface watchdog: page has no visible content" and the UI stalls.
# Measured on the affected host, dropping the GPU process takes the crash count
# from three per run to zero and the app stays up.
#
# The application is fully usable under software rendering, which is what it
# falls back to anyway. Pass `--enable-gpu` to keep the GPU process when the
# host's driver stack does work; the flag is consumed here and not forwarded.
want_gpu=0
remaining=$#
while [ "$remaining" -gt 0 ]; do
  arg=$1
  shift
  case "$arg" in
    --enable-gpu) want_gpu=1 ;;
    --disable-gpu) want_gpu=1; set -- "$@" "$arg" ;;
    *) set -- "$@" "$arg" ;;
  esac
  remaining=$((remaining - 1))
done
[ "$want_gpu" -eq 1 ] || set -- "$@" --disable-gpu

exec "$DIR/dsh-desktop" "$@"
